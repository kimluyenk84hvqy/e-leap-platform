{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://e-leap.local/schemas/lesson.schema.json",
  "title":"E-LEAP Native Lesson Schema v1.0",
  "type":"object",
  "required":["schemaVersion","id","title","status","screens"],
  "properties":{
    "schemaVersion":{"const":"1.0"},"id":{"type":"string","minLength":1},"resourceId":{"type":"string"},"courseId":{"type":"string"},"unitId":{"type":"string"},"lessonNumber":{"type":"string"},"title":{"type":"string","minLength":1},"status":{"enum":["draft","published","hidden","archived"]},
    "screens":{"type":"array","minItems":1,"items":{"type":"object","required":["id","title","activity"],"properties":{"id":{"type":"string"},"stage":{"type":"string"},"title":{"type":"string"},"instruction":{"type":"string"},"activity":{"$ref":"activity.schema.json"}}}}
  },
  "additionalProperties":true
}
